APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database
# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# --- Mailtrap (pengujian email, development/staging) ---
# Panduan lengkap: lihat tutor.md
# 1. Buat inbox di https://mailtrap.io (Email Testing, bukan Email Sending).
# 2. Salin host/port/username/password dari SMTP Settings.
# 3. Jalankan: php artisan config:clear
# 4. Uji dengan: php artisan okim:test-mail alamat@tujuan.com
# 5. Email notifikasi lewat queue: php artisan queue:work --tries=3
#
# MAIL_MAILER=smtp
# MAIL_SCHEME=null
# MAIL_HOST=sandbox.smtp.mailtrap.io
# MAIL_PORT=2525
# MAIL_USERNAME=username-dari-mailtrap
# MAIL_PASSWORD=password-dari-mailtrap
# MAIL_FROM_ADDRESS=noreply@okim.test
# MAIL_FROM_NAME="O-KIM Fuel Terminal Tegal"

# --- Amazon SES (produksi, belum aktif) ---
# Panduan lengkap: lihat README.md bagian "Email (SMTP)" → Amazon SES
# 1. Verifikasi domain di SES region ap-southeast-3 (Jakarta).
# 2. Pasang DNS: DKIM (3 CNAME), SPF, DMARC.
# 3. Ajukan production access (keluar dari sandbox).
# 4. Buat SMTP credentials di SES → SMTP Settings.
# 5. Jalankan: php artisan config:clear
# 6. Uji: php artisan okim:test-mail alamat@domain-anda.com
#
# MAIL_MAILER=smtp
# MAIL_SCHEME=null
# MAIL_HOST=email-smtp.ap-southeast-3.amazonaws.com
# MAIL_PORT=587
# MAIL_USERNAME=smtp-username-dari-ses
# MAIL_PASSWORD=smtp-password-dari-ses
# MAIL_FROM_ADDRESS=noreply@okim.id
# MAIL_FROM_NAME="O-KIM Fuel Terminal Tegal"

# --- Google Workspace SMTP (alternatif produksi) ---
# 1. Aktifkan verifikasi 2 langkah pada akun Google pengirim.
# 2. Buat App Password: https://myaccount.google.com/apppasswords
# 3. Isi nilai di bawah lalu jalankan: php artisan config:clear
# 4. Uji dengan: php artisan okim:test-mail alamat@tujuan.com
#
# MAIL_SCHEME: biarkan null (port 465 otomatis memakai smtps, port lain memakai smtp).
# Jangan memakai "tls" — bukan scheme yang didukung Symfony Mailer.
#
# MAIL_MAILER=smtp
# MAIL_SCHEME=null
# MAIL_HOST=smtp.gmail.com
# MAIL_PORT=587
# MAIL_USERNAME=noreply@domain-anda.com
# MAIL_PASSWORD=app-password-16-karakter
# MAIL_FROM_ADDRESS=noreply@domain-anda.com
# MAIL_FROM_NAME="O-KIM Fuel Terminal Tegal"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=/auth/google/callback
